# Copia a frontend/.env.local (o .env). Documentación: backend/doc/ENVIRONMENT.md
# Las NEXT_PUBLIC_* se incrustan en el bundle al construir: no pongas secretos aquí.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FEATURED_TEACHER_USERNAME=
# No definas NODE_ENV: Next lo gestiona.
