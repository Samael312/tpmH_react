# Copia a backend/.env y rellena. NUNCA subas el .env real. Ejecuta el backend siempre desde backend/.
# Documentación: backend/doc/ENVIRONMENT.md

# --- Obligatorias ---
# Usa una rama Neon de desarrollo o PostgreSQL local, NO la base de producción.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Sin esta clave la app no arranca (el cliente se crea al importar). Vale una de prueba.
OPENAI_API_KEY=

# --- App ---
ENVIRONMENT=development            # "production" oculta /docs y bloquea flow_tests
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
# COOKIE_DOMAIN=.tuprofemaria.com   # producción (mismo sitio); vacío en local
# COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
FEATURED_TEACHER_USERNAME=
LANDING_CACHE_TTL_SECONDS=

# --- Emails (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Soporte <soporte@tu-dominio-verificado.com>

# --- Archivos (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_VIDEO_UPLOAD_MB=100
TTS_CACHE_FOLDER=tts_cache
# TTS por API Realtime (opcionales; estos son los valores por defecto)
# TTS_REALTIME_MODEL=gpt-realtime-2.1-mini
# TTS_MAX_CONCURRENCY=5
# TTS_WORD_TIMEOUT_SECONDS=45
# TTS_WORD_ATTEMPTS=2

# --- Google (login y Calendar). Mismo CLIENT_ID que NEXT_PUBLIC_GOOGLE_CLIENT_ID ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe ser https en producción y coincidir con la URI autorizada en Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:3000/teacher/calendar/callback

# --- IA opcional ---
GEMINI_API_KEY=
